# Имя compose-проекта — префикс контейнеров/volume (чтобы не пересекаться с другими проектами)
COMPOSE_PROJECT_NAME=availia

# UID/GID юзера на хосте (id -u, id -g)
HOST_UID=1000
HOST_GID=1000

# Порты наружу (поменяй, если заняты другим проектом)
APP_PORT=80
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_PGADMIN_PORT=5050

# База (те же значения — в src/.env)
DB_DATABASE=availia
DB_USERNAME=availia
DB_PASSWORD=

# Redis (то же значение — в src/.env)
REDIS_PASSWORD=

# ProxyAPI (proxyapi.ru) — нужен Go-гейтвею для стриминга
PROXY_API_KEY=
PROXY_API_URL=https://api.proxyapi.ru/v1

# pgadmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Общий секрет Laravel ↔ Go-гейтвей (одинаковый в .env и src/.env)
GATEWAY_SECRET=
